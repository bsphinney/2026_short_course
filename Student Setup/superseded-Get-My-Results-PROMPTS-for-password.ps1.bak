# =============================================================================
#  Get My Results  --  Proteomics Short Course 2026
#  Downloads your results from Hive to your own Windows computer.
#
#  HOW TO USE
#    Right-click this file  ->  "Run with PowerShell"
#    Pick your number from the list, type your Hive password, done.
#
#  There are NO passwords in this file, and it never asks you to store one.
#  Everything below is public information -- account names are printed in your
#  handout. When it copies your files, Hive itself asks you for your password
#  and only you ever type it.
# =============================================================================

# --- The class list -----------------------------------------------------------
# Instructor: to show real names instead of account numbers, put the student's
# name as the value. Anything left blank just shows the account name.
$Roster = [ordered]@{
    'proteomics-class-01' = ''
    'proteomics-class-02' = ''
    'proteomics-class-03' = ''
    'proteomics-class-04' = ''
    'proteomics-class-05' = ''
    'proteomics-class-06' = ''
    'proteomics-class-07' = ''
    'proteomics-class-08' = ''
    'proteomics-class-09' = ''
    'proteomics-class-10' = ''
    'proteomics-class-11' = ''
    'proteomics-class-12' = ''
    'proteomics-class-13' = ''
    'proteomics-class-14' = ''
    'proteomics-class-15' = ''
    'proteomics-class-16' = ''
    'proteomics-class-17' = ''
    'proteomics-class-18' = ''
    'proteomics-class-19' = ''
    'proteomics-class-20' = ''
    'proteomics-class-21' = ''
    'proteomics-class-22' = ''
    'proteomics-class-23' = ''
    'proteomics-class-24' = ''
    'proteomics-class-25' = ''
    'proteomics-class-26' = ''
    'proteomics-class-27' = ''
    'proteomics-class-28' = ''
    'proteomics-class-29' = ''
    'proteomics-class-30' = ''
}

$HiveHost = 'hive.hpc.ucdavis.edu'

# -----------------------------------------------------------------------------

$ErrorActionPreference = 'Stop'

function Pause-Then-Exit {
    param([int]$Code = 0)
    Write-Host ''
    Write-Host 'Press Enter to close this window.' -ForegroundColor DarkGray
    [void](Read-Host)
    exit $Code
}

Clear-Host
Write-Host ''
Write-Host '  Proteomics Short Course 2026 - Get My Results' -ForegroundColor Cyan
Write-Host '  ---------------------------------------------' -ForegroundColor Cyan
Write-Host ''

# scp ships with Windows 10/11. If it is genuinely missing, say what to do about
# it rather than failing with a bare "not recognized".
if (-not (Get-Command scp -ErrorAction SilentlyContinue)) {
    Write-Host '  PROBLEM: this computer has no "scp" command.' -ForegroundColor Red
    Write-Host ''
    Write-Host '  Windows 10 and 11 normally include it. To switch it on:'
    Write-Host '    Settings > System > Optional features > Add a feature'
    Write-Host '    > OpenSSH Client > Install, then restart this script.'
    Pause-Then-Exit 1
}

# --- Pick your account --------------------------------------------------------
$accounts = @($Roster.Keys)
Write-Host '  Which one are you?'
Write-Host ''
for ($i = 0; $i -lt $accounts.Count; $i++) {
    $acct  = $accounts[$i]
    $label = if ($Roster[$acct]) { "$($Roster[$acct])   ($acct)" } else { $acct }
    Write-Host ('    {0,2}. {1}' -f ($i + 1), $label)
}
Write-Host ''

$choice = Read-Host '  Type your number and press Enter'
$n = 0
if (-not [int]::TryParse($choice.Trim(), [ref]$n) -or $n -lt 1 -or $n -gt $accounts.Count) {
    Write-Host ''
    Write-Host ("  That was not a number between 1 and {0}. Run the script again." -f $accounts.Count) -ForegroundColor Red
    Pause-Then-Exit 1
}
$User = $accounts[$n - 1]

# --- Where the files will land ------------------------------------------------
# The Desktop, so they cannot be "lost" in whatever folder the shell started in.
$Dest = Join-Path ([Environment]::GetFolderPath('Desktop')) 'Proteomics-Results'
New-Item -ItemType Directory -Force -Path $Dest | Out-Null

Write-Host ''
Write-Host "  Account : $User"
Write-Host "  Saving to: $Dest"
Write-Host ''
Write-Host '  Hive will now ask for your password.' -ForegroundColor Yellow
Write-Host '  Nothing appears as you type it - no dots, no stars. That is normal.' -ForegroundColor Yellow
Write-Host ''

# --- Copy ---------------------------------------------------------------------
# Two patterns, tried in turn: the zipped sessions, then any HTML report. Each is
# attempted separately so one missing pattern does not abort the other. Paths
# after the colon are relative to the Hive home directory.
$patterns = @(
    @{ Path = 'sessions/*.zip';              What = 'zipped session folders' },
    @{ Path = 'sessions/*/output/*.html';    What = 'HTML reports' }
)

$got = 0
foreach ($p in $patterns) {
    Write-Host "  Looking for $($p.What)..." -ForegroundColor DarkGray
    $before = @(Get-ChildItem -Path $Dest -File -ErrorAction SilentlyContinue).Count
    & scp -o StrictHostKeyChecking=accept-new "$User@${HiveHost}:$($p.Path)" "$Dest" 2>&1 |
        ForEach-Object { if ($_ -notmatch 'No such file or directory') { Write-Host "    $_" } }
    $after = @(Get-ChildItem -Path $Dest -File -ErrorAction SilentlyContinue).Count
    $new = $after - $before
    if ($new -gt 0) {
        Write-Host "    got $new file(s)" -ForegroundColor Green
        $got += $new
    } else {
        Write-Host '    none found (that is fine if you have not made them yet)' -ForegroundColor DarkGray
    }
}

# --- Report -------------------------------------------------------------------
Write-Host ''
if ($got -gt 0) {
    Write-Host "  Done - $got file(s) copied to your Desktop, in Proteomics-Results." -ForegroundColor Green
    Write-Host '  Double-click any .html file to read your report in a browser.'
    Start-Process explorer.exe $Dest
} else {
    Write-Host '  Nothing was copied.' -ForegroundColor Yellow
    Write-Host ''
    Write-Host '  The usual reasons, in order of likelihood:'
    Write-Host '    1. You have not run an analysis yet, or have not asked Claude Code'
    Write-Host '       to "make me the HTML report, then zip up my session folder".'
    Write-Host '    2. You picked the wrong number from the list.'
    Write-Host '    3. The password was mistyped - it would have said "Permission denied".'
    Write-Host ''
    Write-Host '  To check what you actually have, log into Hive and run:  ls sessions/'
}
Pause-Then-Exit 0
